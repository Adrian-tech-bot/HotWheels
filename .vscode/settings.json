{
  "files.associations": {
    "*.ino": "cpp"
  },
  "files.exclude": {
    "**/.direnv": true,
    "**/result": true
  },
  "search.exclude": {
    "**/.direnv": true,
    "**/result": true
  },
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.serverSettings": {
    "nixd": {
      "formatting": {
        "command": [
          "nixfmt"
        ]
      }
    }
  },
  "emeraldwalk.runonsave": {
    "ignoreUnchangedFiles": true,
    "commands": [
      {
        "match": "\\.(nix|ino|c|cc|cpp|h|hh|hpp|md|json|yml|yaml)$",
        "cmd": "cd \"${workspaceFolder}\" && nix fmt -- \"${relativeFile}\""
      }
    ]
  },
  "C_Cpp.default.cppStandard": "gnu++11"
}
